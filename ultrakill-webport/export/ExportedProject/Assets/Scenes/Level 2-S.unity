    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"What's the point of making it better? ▼\nWhat's the point of even bothering to care? ▼\nHell, what's the point of anything at all? ▼\nNothing. ▼\nAbsolutely nothing.\" ▼"
