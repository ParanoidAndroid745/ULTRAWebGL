    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"We sublimate it. ▼\nWe transform our self-reflective suffering into another form, art, to keep it from consuming us. ▼\nAnything to avoid the panic.\" ▼"
