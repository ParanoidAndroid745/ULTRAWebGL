    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 2
    m_MaxSize: 24
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: '"It is because we have no greater purpose, that time spent on goals set by one''s self cannot be time wasted."'
--- !u!114 &15269
