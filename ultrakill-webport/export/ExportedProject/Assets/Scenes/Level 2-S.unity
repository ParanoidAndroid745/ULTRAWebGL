      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5313775538f09da469dbd33b37aa1ff9, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 1
    m_MaxSize: 22
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"Wandering around like headless chickens would only get us even more lost.\" ▼"
