    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"We can only ever ignore it, hide from it or temporarily escape from it, but the fact is that we are bound to the way of all things.\" ▼"
