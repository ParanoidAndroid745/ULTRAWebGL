    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Enabling cheats means you will not gain a rank upon completion of a level and a Cyber Grind high score will not be saved.\n\n<color=green>Press <color=white>~</color> or <color=white>home</color> after enabling cheats to toggle the menu</color>"
