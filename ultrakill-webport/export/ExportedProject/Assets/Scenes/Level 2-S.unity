    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"Well I just got knocked over by some blind-by-choice asshole who gave my skirt a decorative dirt coating, so all in all fucking fantastic, though I would prefer to not be on the ground right now.\" ▼"
