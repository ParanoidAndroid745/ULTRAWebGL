    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"The human mind is an evolutionary maladaptation caused by going too far in a direction that was once beneficial and will, sooner or later, lead to our extinction. ▼\nOn an individual level, it's already happening.\" ▼"
--- !u!114 &14827
