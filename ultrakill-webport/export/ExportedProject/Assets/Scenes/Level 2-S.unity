    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"Bullshit! ▼\nCut the crap, I can see your crusty-ass uniform and no living person would dare to go out looking like a filled trash bag by choice!\" ▼"
