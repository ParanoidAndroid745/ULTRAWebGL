    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: "\n\"Though, by the looks of it, you're pretty much on the same boat, and by a stroke of once-in-a-lifetime luck you just happened to bump into the ~prettiest girl in town~.\" ▼"
